VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_supabase_project.supabase.co"

# Optional: Email configuration (not required, defaults are used if not set)
# VITE_RESEND_FROM_EMAIL=IfsinRem <no-reply@ifsinrem.site>

# IMPORTANT: Resend API Key
# NEVER expose the RESEND_API_KEY in the frontend or .env files!
# Configure it ONLY as a Supabase Edge Function secret via the Supabase Dashboard:
# Supabase Console → Edge Functions → Settings → Secrets → Add secret
# Key: RESEND_API_KEY
# Value: re_*****
